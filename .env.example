# Empty NEXT_PUBLIC_API_URL = browser uses same origin; Next rewrites /api → API_INTERNAL_URL
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://127.0.0.1:8000

# Google / Microsoft OAuth: configure on the API only (GOOGLE_CLIENT_ID, MICROSOFT_*)
# UI fetches public client IDs from GET /api/v1/auth/oauth-providers
